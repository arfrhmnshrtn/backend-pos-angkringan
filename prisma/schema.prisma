// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH MODELS
// ==========================================

model user {
  id       Int         @id @default(autoincrement())
  fullname String
  pin      String
  role     user_role
  status   user_status @default(ACTIVE)

  refresh_tokens     refresh_token[]
  transaksi_keuangan transaksi_keuangan[]
  debt_created       debt[] @relation("UserCreatedDebt")
  debt_payments      debt_payment[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([role])
  @@index([status])
  @@index([deleted_at])
}

model permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  role_permissions role_permission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model role_permission {
  id            Int       @id @default(autoincrement())
  role          user_role
  permission_id Int

  permission permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([role, permission_id], name: "role_permission_id")
  @@index([role])
  @@index([permission_id])
}

model refresh_token {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String
  expired_at DateTime

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([expired_at])
}

enum user_role {
  OWNER
  KASIR
}

enum user_status {
  ACTIVE
  INACTIVE
}

// ==========================================
// POS MODELS
// ==========================================

model katalog_menu {
  id          Int      @id @default(autoincrement())
  nama_item   String
  kategori    kategori
  stok        Int
  harga_modal Int
  harga_jual  Int
  url_gambar  String?

  detail_pesanan detail_pesanan[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model pesanan {
  id Int @id @default(autoincrement())

  nomor_pesanan String @unique

  nama_pelanggan String?

  total_item Int

  total_harga Int

  metode_pembayaran metode_pembayaran?

  status status_pesanan @default(belum_bayar)

  detail_pesanan     detail_pesanan[]
  transaksi_keuangan transaksi_keuangan[]
  debt               debt?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model detail_pesanan {
  id Int @id @default(autoincrement())

  id_pesanan Int
  pesanan    pesanan @relation(fields: [id_pesanan], references: [id])

  id_menu Int
  menu    katalog_menu @relation(fields: [id_menu], references: [id])

  nama_menu String
  harga     Int
  jumlah    Int
  subtotal  Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model kategori_keuangan {
  id Int @id @default(autoincrement())

  nama String @unique

  jenis jenis_transaksi

  transaksi_keuangan transaksi_keuangan[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model transaksi_keuangan {
  id Int @id @default(autoincrement())

  nomor_transaksi String @unique

  jenis jenis_transaksi

  id_kategori Int
  kategori    kategori_keuangan @relation(fields: [id_kategori], references: [id])

  nominal Int

  metode_pembayaran metode_pembayaran?

  keterangan String

  id_pesanan Int?
  pesanan    pesanan? @relation(fields: [id_pesanan], references: [id])

  id_user Int
  user    user @relation(fields: [id_user], references: [id])

  debt_payment debt_payment?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum status_pesanan {
  belum_bayar
  lunas
  hutang
}

enum metode_pembayaran {
  tunai
  qris
  transfer
}

enum jenis_transaksi {
  pemasukan
  pengeluaran
}

enum kategori {
  bakaran
  jajanan
  minuman
  makanan
}

// ==========================================
// DEBT MODELS
// ==========================================

model debt {
  id Int @id @default(autoincrement())
  
  type debt_type
  
  customer_name String?
  supplier_name String?
  
  note String?
  
  total_amount Int
  paid_amount Int @default(0)
  remaining_amount Int
  
  status debt_status @default(BELUM_LUNAS)
  
  id_pesanan Int? @unique
  pesanan pesanan? @relation(fields: [id_pesanan], references: [id])
  
  created_by Int
  user user @relation("UserCreatedDebt", fields: [created_by], references: [id])

  payments debt_payment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model debt_payment {
  id Int @id @default(autoincrement())
  
  id_debt Int
  debt debt @relation(fields: [id_debt], references: [id], onDelete: Cascade)
  
  amount Int
  
  payment_method metode_pembayaran
  
  paid_at DateTime @default(now())
  
  id_user Int
  user user @relation(fields: [id_user], references: [id])
  
  id_transaksi_keuangan Int? @unique
  transaksi_keuangan transaksi_keuangan? @relation(fields: [id_transaksi_keuangan], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum debt_type {
  CUSTOMER
  SUPPLIER
}

enum debt_status {
  BELUM_LUNAS
  SEBAGIAN
  LUNAS
  DIBATALKAN
}

